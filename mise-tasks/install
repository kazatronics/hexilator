#!/usr/bin/env bash
#MISE description="Install Hexilator at a git ref into FreeCAD's user Mod folder (HEXILATOR_SOURCE, HEXILATOR_REF)"
set -euo pipefail
# An install is a git checkout of a ref at <FreeCAD user data>/Mod/Hexilator.
#   HEXILATOR_SOURCE  repo URL or local path (default: the GitHub repo)
#   HEXILATOR_REF     tag, branch or full commit SHA to check out (required, or pass it as $1)
#   FREECAD_USER_DATA respected, as FreeCAD itself does
source="${HEXILATOR_SOURCE:-https://github.com/kazatronics/hexilator.git}"
ref="${1:-${HEXILATOR_REF:?set HEXILATOR_REF or pass a tag, branch or commit SHA}}"
freecadcmd="${FREECADCMD:-freecadcmd}"
data="${FREECAD_USER_DATA:-}"
if [ -z "$data" ]; then
  data="$("$freecadcmd" -c 'import FreeCAD; print("HEXDIR=" + FreeCAD.getUserAppDataDir())' 2>/dev/null \
    | sed -n 's/^HEXDIR=//p' | tail -n1)"
fi
[ -n "$data" ] || { echo "could not find FreeCAD's user data dir" >&2; exit 1; }
dest="${data%/}/Mod/Hexilator"
mkdir -p "$(dirname "$dest")"
if [ -L "$dest" ]; then
  echo "$dest is a symlink (a development link); remove it first" >&2
  exit 1
fi
if [ ! -d "$dest/.git" ]; then
  if [ -e "$dest" ]; then
    echo "$dest exists but is not a git checkout; remove it first" >&2
    exit 1
  fi
  git clone --quiet "$source" "$dest"
else
  git -C "$dest" remote set-url origin "$source"
fi
git -C "$dest" fetch --quiet --tags --force origin
if git -C "$dest" rev-parse --verify --quiet "refs/remotes/origin/$ref" >/dev/null; then
  target="refs/remotes/origin/$ref"   # a branch: follow its latest commit
elif git -C "$dest" rev-parse --verify --quiet "refs/tags/$ref" >/dev/null; then
  target="refs/tags/$ref"
elif [[ "$ref" =~ ^[0-9a-f]{40}$ ]]; then
  target="$ref"                       # a commit: must be on a fetched branch or tag
else
  target=""
fi
if [ -z "$target" ] || ! want="$(git -C "$dest" rev-parse --verify --quiet "$target^{commit}")"; then
  echo "no branch, tag or commit '$ref' in $source (commits must be full 40-character SHAs)" >&2
  exit 1
fi
have="$(git -C "$dest" rev-parse HEAD 2>/dev/null || true)"
if [ "$want" != "$have" ]; then
  git -C "$dest" -c advice.detachedHead=false checkout --quiet --force "$want"
fi
if [ ! -f "$dest/package.xml" ]; then
  echo "'$ref' has no package.xml: not an installable Hexilator version" >&2
  exit 1
fi
version="$(sed -n 's:.*<version>\(.*\)</version>.*:\1:p' "$dest/package.xml" | head -n1)"
echo "Hexilator $version ($ref, ${want:0:12}) at $dest"
